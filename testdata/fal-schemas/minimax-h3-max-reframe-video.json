{"openapi":"3.1.0","info":{"title":"Queue OpenAPI for minimax/h3-max/reframe-video","version":"1.0.0","description":"H3 Max Reframe adapts an existing video to a new aspect ratio by fitting the source onto a target canvas and generating the surrounding areas. It supports source videos from 0.25 to 300 seconds, seven aspect ratios, and 480p, 768p, or 1080p output profiles, with optional text guidance and seed control. The 1080p profile uses learned latent upscaling from a native 768p reframe. The endpoint retains the source timeline and audio, while the generated image is not guaranteed to preserve source pixels exactly.","x-fal-metadata":{"endpointId":"minimax/h3-max/reframe-video","category":"video-to-video","thumbnailUrl":"https://v3b.fal.media/files/b/0aae1b2b/GYNF6LxWxgUK9WD5iYGBV.jpg","playgroundUrl":"https://fal.ai/models/minimax/h3-max/reframe-video","documentationUrl":"https://fal.ai/models/minimax/h3-max/reframe-video/api","about":"Contain-fit the source onto the target canvas and outpaint the rest.\n\nSources within the plain outpaint budget (15 s, ``MAX_SOURCE_BYTES``)\nrun that path; longer or larger sources (up to 300 s) are re-encoded\ninto checkpointed outpaint windows."}},"components":{"securitySchemes":{"apiKeyAuth":{"type":"apiKey","in":"header","name":"Authorization","description":"Fal Key"}},"schemas":{"QueueStatus":{"type":"object","properties":{"status":{"type":"string","enum":["IN_QUEUE","IN_PROGRESS","COMPLETED"]},"request_id":{"type":"string","description":"The request id."},"response_url":{"type":"string","description":"The response url."},"status_url":{"type":"string","description":"The status url."},"cancel_url":{"type":"string","description":"The cancel url."},"logs":{"type":"object","description":"The logs.","additionalProperties":true},"metrics":{"type":"object","description":"The metrics.","additionalProperties":true},"queue_position":{"type":"integer","description":"The queue position."}},"required":["status","request_id"]},"H3MaxReframeVideoInput":{"title":"TurboReframeVideoInput","x-fal-order-properties":["prompt","video_url","aspect_ratio","resolution","seed","enable_safety_checker"],"properties":{"resolution":{"title":"Resolution","default":"768p","description":"Target canvas resolution profile. 1080p uses learned latent upscaling from a native 768p reframe.","enum":["480p","768p","1080p"],"type":"string"},"seed":{"title":"Seed","anyOf":[{"minimum":0,"maximum":4294967295,"type":"integer"},{"type":"null"}]},"video_url":{"title":"Video Url","description":"Source video, 0.25 to 300 seconds; fitted onto the target canvas with its timeline and audio preserved.","type":"string"},"enable_safety_checker":{"title":"Enable Safety Checker","default":true,"type":"boolean"},"prompt":{"title":"Prompt","default":"","description":"Optional guidance for the new surroundings. Expansion captions the source automatically.","maxLength":50000,"type":"string"},"aspect_ratio":{"title":"Aspect Ratio","default":"16:9","description":"Target canvas aspect ratio; the source is contain-fitted and the rest is outpainted.","enum":["16:9","9:16","1:1","4:3","3:4","21:9","9:21"],"type":"string"}},"type":"object","required":["video_url"]},"H3MaxReframeVideoOutput":{"title":"TurboOutpaintVideoOutput","x-fal-order-properties":["video","seed","placement","frame_count","frames_per_second","expanded_prompt"],"properties":{"expanded_prompt":{"title":"Expanded Prompt","anyOf":[{"type":"string"},{"type":"null"}]},"seed":{"title":"Seed","type":"integer"},"placement":{"title":"Placement","type":"object","additionalProperties":{"type":"integer"}},"frames_per_second":{"title":"Frames Per Second","default":24,"type":"integer"},"frame_count":{"title":"Frame Count","type":"integer"},"video":{"$ref":"#/components/schemas/VideoFile"}},"type":"object","required":["video","seed","placement","frame_count"]},"VideoFile":{"title":"VideoFile","x-fal-order-properties":["url","content_type","file_name","file_size","width","height","fps","duration","num_frames"],"properties":{"url":{"title":"Url","description":"The URL where the file can be downloaded from.","type":"string"},"duration":{"title":"Duration","description":"The duration of the video","anyOf":[{"type":"number"},{"type":"null"}]},"num_frames":{"title":"Num Frames","description":"The number of frames in the video","anyOf":[{"type":"integer"},{"type":"null"}]},"content_type":{"title":"Content Type","description":"The mime type of the file.","examples":["image/png"],"anyOf":[{"type":"string"},{"type":"null"}]},"file_name":{"title":"File Name","description":"The name of the file. It will be auto-generated if not provided.","examples":["z9RV14K95DvU.png"],"anyOf":[{"type":"string"},{"type":"null"}]},"fps":{"title":"Fps","description":"The FPS of the video","anyOf":[{"type":"number"},{"type":"null"}]},"file_size":{"title":"File Size","description":"The size of the file in bytes.","examples":[4404019],"anyOf":[{"type":"integer"},{"type":"null"}]},"width":{"title":"Width","description":"The width of the video","anyOf":[{"type":"integer"},{"type":"null"}]},"height":{"title":"Height","description":"The height of the video","anyOf":[{"type":"integer"},{"type":"null"}]}},"type":"object","required":["url"]}}},"paths":{"/minimax/h3-max/reframe-video/requests/{request_id}/status":{"get":{"parameters":[{"name":"request_id","in":"path","required":true,"schema":{"type":"string","description":"Request ID"}},{"name":"logs","in":"query","required":false,"schema":{"type":"number","description":"Whether to include logs (`1`) in the response or not (`0`)."}}],"responses":{"200":{"description":"The request status.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QueueStatus"}}}}}}},"/minimax/h3-max/reframe-video/requests/{request_id}/cancel":{"put":{"parameters":[{"name":"request_id","in":"path","required":true,"schema":{"type":"string","description":"Request ID"}}],"responses":{"200":{"description":"The request was cancelled.","content":{"application/j