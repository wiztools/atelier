{
    "openapi": "3.1.0",
    "info": {
        "title": "Queue OpenAPI for minimax/h3-max/recast",
        "version": "1.0.0",
        "description": "H3 Max Recast replaces the main people in a source video with people from reference photos, tracking each person across shots. Provide a video and one photo per new person, with an optional prompt to specify who becomes whom or which details to keep or change. The model aims to preserve the original motion, gestures, camera, shot timing, and soundtrack. Supports up to four reference photos and videos up to 30 seconds, with individual shots no longer than 15 seconds, at 768p or 1080p.",
        "x-fal-metadata": {
            "endpointId": "minimax/h3-max/recast",
            "category": "video-to-video",
            "thumbnailUrl": "https://v3b.fal.media/files/b/0aacabd7/P2ptkl7_WVxobibHV7Ti7.jpg",
            "playgroundUrl": "https://fal.ai/models/minimax/h3-max/recast",
            "documentationUrl": "https://fal.ai/models/minimax/h3-max/recast/api",
            "about": "Generate"
        }
    },
    "components": {
        "securitySchemes": {
            "apiKeyAuth": {
                "type": "apiKey",
                "in": "header",
                "name": "Authorization",
                "description": "Fal Key"
            }
        },
        "schemas": {
            "QueueStatus": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "IN_QUEUE",
                            "IN_PROGRESS",
                            "COMPLETED"
                        ]
                    },
                    "request_id": {
                        "type": "string",
                        "description": "The request id."
                    },
                    "response_url": {
                        "type": "string",
                        "description": "The response url."
                    },
                    "status_url": {
                        "type": "string",
                        "description": "The status url."
                    },
                    "cancel_url": {
                        "type": "string",
                        "description": "The cancel url."
                    },
                    "logs": {
                        "type": "object",
                        "description": "The logs.",
                        "additionalProperties": true
                    },
                    "metrics": {
                        "type": "object",
                        "description": "The metrics.",
                        "additionalProperties": true
                    },
                    "queue_position": {
                        "type": "integer",
                        "description": "The queue position."
                    }
                },
                "required": [
                    "status",
                    "request_id"
                ]
            },
            "H3MaxRecastInput": {
                "title": "RecastInput",
                "required": [
                    "video_url",
                    "reference_image_urls"
                ],
                "x-fal-order-properties": [
                    "video_url",
                    "reference_image_urls",
                    "prompt",
                    "resolution",
                    "seed",
                    "enhance_realism",
                    "enable_safety_checker"
                ],
                "properties": {
                    "enable_safety_checker": {
                        "title": "Enable Safety Checker",
                        "description": "Authorized callers may set false to request relaxed screening.",
                        "default": true,
                        "type": "boolean"
                    },
                    "reference_image_urls": {
                        "title": "Reference Image URLs",
                        "description": "One photo per new person. By default they replace the main people in the video from left to right, each in every shot they appear in.",
                        "items": {
                            "type": "string"
                        },
                        "maxItems": 4,
                        "minItems": 1,
                        "examples": [
                            [
                                "https://v3b.fal.media/files/b/0aac8d26/HVno2j68vj7tkAwGo3Qii_Nolan%203.jpg"
                            ]
                        ],
                        "type": "array"
                    },
                    "resolution": {
                        "title": "Resolution",
                        "enum": [
                            "768P",
                            "1080P"
                        ],
                        "default": "1080P",
                        "type": "string"
                    },
                    "video_url": {
                        "title": "Video URL",
                        "description": "The source video, 5 to 30 seconds long, with no single shot longer than 15 seconds.",
                        "examples": [
                            "https://v3b.fal.media/files/b/0aac8cc6/lOHY4Mitfg5x1UDerR3RB_dw9Hs7ChHU-Fqwzz0W9cq_video.mp4"
                        ],
                        "type": "string"
                    },
                    "enhance_realism": {
                        "title": "Enhance Realism",
                        "description": "More natural skin textures and better blending of the new people into the scene. Off unless set.",
                        "default": false,
                        "examples": [
                            true
                        ],
                        "type": "boolean"
                    },
                    "seed": {
                        "title": "Seed",
                        "description": "Random seed. Leave empty for a random one.",
                        "anyOf": [
                            {
                                "minimum": 0,
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "prompt": {
                        "title": "Prompt",
                        "description": "Optional: who becomes whom, or what else to keep or change.",
                        "anyOf": [
                            {
                                "maxLength": 2000,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "H3MaxRecastOutput": {
                "title": "RecastOutput",
                "required": [
                    "video",
                    "seed"
                ],
                "x-fal-order-properties": [
                    "video",
                    "seed"
                ],
                "properties": {
                    "seed": {
                        "title": "Seed",
                        "description": "The seed used.",
                        "type": "integer"
                    },
                    "video": {
                        "$ref": "#/components/schemas/File",
                        "description": "The recast video, with the source sound."
                    }
                },
                "type": "object"
            },
            "File": {
                "title": "File",
                "required": [
                    "url"
                ],
                "x-fal-order-properties": [
                    "url",
                    "content_type",
                    "file_name",
                    "file_size"
                ],
                "properties": {
                    "content_type": {
                        "title": "Content Type",
                        "description": "The mime type of the file.",
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "examples": [
                            "image/png"
                        ]
                    },
                    "url": {
                        "title": "Url",
                        "description": "The URL where the file can be downloaded from.",
                        "type": "string"
                    },
                    "file_size": {
                        "title": "File Size",
                        "description": "The size of the file in bytes.",
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "examples": [
                            4404019
                        ]
                    },
                    "file_name": {
                        "title": "File Name",
                        "description": "The name of the file. It will be auto-generated if not provided.",
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "examples": [
                            "z9RV14K95DvU.png"
                        ]
                    }
                },
                "type": "object"
            }
        }
    },
    "paths": {
        "/minimax/h3-max/recast/requests/{request_id}/status": {
            "get": {
                "parameters": [
                    {
                        "name": "request_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Request ID"
                        }
                    },
                    {
                        "name": "logs",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "description": "Whether to include logs (`1`) in the response or not (`0`)."
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The request status.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/QueueStatus"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/minimax/h3-max/recast/requests/{request_id}/cancel": {
            "put": {
                "parameters": [
                    {
                        "name": "request_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Request ID"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The request was cancelled.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "description": "Whether the request was cancelled successfully."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/minimax/h3-max/recast": {
            "post": {
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/H3MaxRecastInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The request status.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/QueueStatus"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/minimax/h3-max/recast/requests/{request_id}": {
            "get": {
                "parameters": [
                    {
                        "name": "request_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Request ID"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Result of the request.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/H3MaxRecastOutput"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "url": "https://queue.fal.run"
        }
    ],
    "security": [
        {
            "apiKeyAuth": []
        }
    ]
}
