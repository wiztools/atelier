                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Request ID"
                        }
                    },
                    {
                        "name": "logs",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "description": "Whether to include logs (`1`) in the response or not (`0`)."
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The request status.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/QueueStatus"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/fal-ai/kling-video/o3/pro/video-to-video/edit/requests/{request_id}/cancel": {
            "put": {
                "parameters": [
                    {
                        "name": "request_id",
