                                    "description": "URL of the output video.",
                                    "type": "string",
                                    "format": "uri"
                                },
                                "videoBase64Data": {
                                    "title": "Video Base64 Data",
                                    "description": "Base64-encoded video data.",
                                    "type": "string"
                                },
