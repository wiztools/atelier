{
    "openapi": "3.1.0",
    "info": {
        "title": "Runware API - P-Video-Replace",
        "summary": "Character replacement for existing video using a reference image while preserving motion, timing, camera, and scene",
        "description": "P-Video-Replace is a video transformation model that swaps the on-camera character in an existing video with the character from a reference image. It is built to preserve the original motion, timing, camera behavior, lighting, and background while changing who appears in the clip, making it useful for UGC ad variations, content localization, avatar or mascot insertion, and other scalable character-replacement workflows.",
        "version": "1.0.0",
        "x-model-id": "prunaai-p-video-replace",
        "x-air-id": "prunaai:p-video@replace",
        "x-status": "live",
