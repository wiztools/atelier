                            "title": "Delivery Method",
                            "description": "Determines how the API delivers task results.",
                            "type": "string",
                            "oneOf": [
                                {
                                    "const": "sync",
                                    "description": "Returns results directly in the API response. Over HTTP, a task still running after 120 seconds continues as an async task and comes back with status 'processing'. Poll for its results using getResponse."
                                },
                                {
                                    "const": "async",
                                    "description": "Returns an immediate acknowledgment with the task UUID. Poll for results using getResponse."
                                }
                            ],
                            "default": "async"
                        },
