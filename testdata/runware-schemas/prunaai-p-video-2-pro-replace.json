{
    "openapi": "3.1.0",
    "info": {
        "title": "Runware API - P-Video-2-Pro-Replace",
        "summary": "Replace one or two people in an existing video from a photo, keeping motion, camera, and lip sync",
        "description": "P-Video-2-Pro-Replace is Pruna AI's character replacement model that puts the person from one or two photos into an existing video. It keeps the original camera, background, timing, and motion, carries over the source soundtrack with lips that follow it, and replaces two people at once with a prompt that says who replaces whom. It takes source clips from 1 second to 2 minutes and outputs from 480p up to 4K, for UGC ad variations, localized spokesperson videos, and recasting existing footage.",
        "version": "1.0.0",
