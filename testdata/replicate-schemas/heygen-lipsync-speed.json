            "title": "Video",
            "format": "uri",
            "x-order": 0,
            "description": "Source video file to lip-sync."
           },
           "disable_music_track": {
            "type": "boolean",
            "title": "Disable Music Track",
            "default": false,
            "x-order": 3,
            "description": "Strip background music from the source video."
           },
           "enable_dynamic_duration": {
            "type": "boolean",
            "title": "Enable Dynamic Duration",
            "default": true,
            "x-order": 2,
            "description": "Allow the output duration to adjust to match the new audio length."
           },
           "enable_speech_enhancement": {
            "type": "boolean",
            "title": "Enable Speech Enhancement",
            "default": false,
            "x-order": 4,
            "description": "Enhance speech quality in the output."
           }
          }
         }
        }
       }
      }
     }
    }
