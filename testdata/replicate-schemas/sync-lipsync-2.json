    },
    "parameters": [
     {
      "in": "path",
      "name": "prediction_id",
      "schema": {
       "type": "string",
       "title": "Prediction Id"
      },
      "required": true
     }
    ],
    "operationId": "cancel_predictions__prediction_id__cancel_post"
   }
  }
